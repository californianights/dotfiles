* {
    font: "JetBrainsMono Nerd Font 12";
    text-color: #c0caf5;
}

window {
    width: 440px;
    background-color: #1a1b26;
    border: 1px;
    border-color: #414868;
    border-radius: 10px;
    padding: 10px;
}

mainbox {
    background-color: #1a1b26;
    children: [inputbar, listview];
}

inputbar {
    background-color: #1a1b26;
    padding: 6px 8px 10px;
    children: [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color: #7aa2f7;
    padding: 0 8px 0 0;
}

entry {
    background-color: transparent;
    text-color: #c0caf5;
}

listview {
    background-color: #1a1b26;
    spacing: 3px;
    scrollbar: false;
}

element {
    background-color: transparent;
    padding: 9px 12px;
    border-radius: 7px;
}

element selected {
    background-color: #24283b;
}

element-text {
    background-color: transparent;
    text-color: #c0caf5;
}
