* {
    font: "JetBrainsMono Nerd Font 12";
    text-color: #c0caf5;
}

window {
    width: 320px;
    background-color: #1a1b26;
    border: 1px;
    border-color: #414868;
    border-radius: 8px;
    padding: 8px;
}

mainbox {
    background-color: #1a1b26;
    children: [listview];
}

listview {
    background-color: #1a1b26;
    spacing: 2px;
    scrollbar: false;
}

element {
    background-color: #1a1b26;
    padding: 7px 10px;
    border-radius: 6px;
}

element selected {
    background-color: #24283b;
}

element-text {
    background-color: transparent;
    text-color: #c0caf5;
}
