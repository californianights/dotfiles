{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "custom/recording",
        "custom/weather",
        "clock"
    ],
    "modules-right": [
        "battery",
        "bluetooth",
        "pulseaudio",
        "network",
        "hyprland/language",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },
    "clock": {
        "format": "{:%a  %H:%M}",
        "tooltip": false,
        "on-click": "~/.dotfiles/config/waybar/scripts/go/bin/reminder add"
    },
    "custom/weather": {
        "exec": "~/.dotfiles/config/waybar/scripts/weather.sh",
        "interval": 900,
        "return-type": "json",
        "format": "{}"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "{icon} {capacity}%",
        "format-plugged": "{icon} {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip": true,
        "tooltip-format": "{capacity}% · {timeTo}",
        "on-click": "~/.dotfiles/config/waybar/scripts/go/bin/power-profiles"
    },
    "custom/recording": {
        "exec": "~/.dotfiles/config/waybar/scripts/recording.sh",
        "interval": 1,
        "return-type": "json",
        "format": "{}"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂯",
        "format-connected-battery": "󰂯 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "~/.dotfiles/config/waybar/scripts/go/bin/bluetooth-menu"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "{icon}  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰖪  Disconnected",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "~/.dotfiles/config/waybar/scripts/wifi-menu.sh"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.dotfiles/config/waybar/scripts/power-menu.sh"
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU",
        "keyboard-name": "at-translated-set-2-keyboard"
    }
}
